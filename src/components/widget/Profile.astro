---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
const hasPartner = !!profileConfig.partner;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <!-- 双人头像区域 -->
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon is:inline
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    {hasPartner ? (
      <div class="flex items-center justify-center gap-2 p-2">
        <div class="relative flex-1 max-w-[45%]">
          <ImageWrapper
            src={profileConfig.avatar || ""}
            alt={profileConfig.name}
            class="profile-avatar-image rounded-full aspect-square object-cover"
            loading="eager"
            fetchpriority="high"
            widths={[150]}
            sizes="150px"
          />
          <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 text-[10px] font-bold text-neutral-600 dark:text-neutral-300 bg-white/80 dark:bg-neutral-800/80 px-1.5 py-0.5 rounded-full whitespace-nowrap">
            {profileConfig.name}
          </div>
        </div>
        <div class="text-pink-400 text-lg font-bold">♡</div>
        <div class="relative flex-1 max-w-[45%]">
          <ImageWrapper
            src={profileConfig.partner!.avatar || ""}
            alt={profileConfig.partner!.name}
            class="profile-avatar-image rounded-full aspect-square object-cover"
            loading="eager"
            fetchpriority="high"
            widths={[150]}
            sizes="150px"
          />
          <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 text-[10px] font-bold text-neutral-600 dark:text-neutral-300 bg-white/80 dark:bg-neutral-800/80 px-1.5 py-0.5 rounded-full whitespace-nowrap">
            {profileConfig.partner!.name}
          </div>
        </div>
      </div>
    ) : (
      <ImageWrapper
        src={profileConfig.avatar || ""}
        alt="Profile Image of the Author"
        class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
        loading="eager"
        fetchpriority="high"
        widths={[350]}
        sizes="350px"
      />
    )}
  </a>

  <div class="px-2">
    {hasPartner ? (
      <div class="text-center mb-1.5">
        <span class="font-bold text-xl text-neutral-800 dark:text-neutral-50 transition">
          {profileConfig.name}
        </span>
        <span class="text-pink-400 mx-1.5 text-lg">♡</span>
        <span class="font-bold text-xl text-neutral-800 dark:text-neutral-50 transition">
          {profileConfig.partner!.name}
        </span>
      </div>
    ) : (
      <div
        class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
      >
        {profileConfig.name}
      </div>
    )}

    <div
      class="h-0.5 w-8 bg-gradient-to-r from-transparent via-(--primary) to-transparent mx-auto rounded-full mb-2.5 transition"
    >
    </div>

    <div class="text-center text-neutral-400 mb-1 transition text-sm">
      {profileConfig.bio}
    </div>
    <div class="text-center text-neutral-300 dark:text-neutral-600 mb-2.5 transition text-xs">
      zf ♡ ltt · 2024.07.14 起
    </div>

    <!-- 链接按钮 -->
    <div class="flex flex-wrap gap-2 justify-center mb-1">
      {profileConfig.links.length > 1 && profileConfig.links.map(item => {
        const showName = item.showName;
        const className = showName
          ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95"
          : "btn-regular rounded-lg h-10 w-10 active:scale-90";

        if (item.url.startsWith("mailto:")) {
          const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
          return (
            <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail}
              onclick={`(function() { var e = atob(this.getAttribute('data-encoded-email')); this.href='mailto:'+e; this.removeAttribute('data-encoded-email'); this.removeAttribute('onclick'); this.click(); return false; }).call(this);`.replace(/\s+/g, " ").trim()}
              class={className}>
              <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
              {showName && item.name}
            </a>
          );
        } else {
          return (
            <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
              <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
              {showName && item.name}
            </a>
          );
        }
      })}
      {profileConfig.links.length === 1 && (() => {
        const item = profileConfig.links[0];
        if (item.url.startsWith("mailto:")) {
          const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
          return (
            <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail}
              onclick={`(function() { var e = atob(this.getAttribute('data-encoded-email')); this.href='mailto:'+e; this.removeAttribute('data-encoded-email'); this.removeAttribute('onclick'); this.click(); return false; }).call(this);`.replace(/\s+/g, " ").trim()}
              class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
              <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
              {item.name}
            </a>
          );
        } else {
          return (
            <a rel="me" aria-label={item.name} href={item.url} target="_blank"
              class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
              <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
              {item.name}
            </a>
          );
        }
      })()}
    </div>
  </div>
</div>
