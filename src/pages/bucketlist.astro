---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "心愿清单";
const description = "一起想做的事，一起走过的路";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-8 relative w-full">
      <!-- 页面标题 -->
      <div class="text-center mb-6">
        <div class="text-3xl mb-2">Bucket List</div>
        <h1 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100 mb-1">
          {title}
        </h1>
        <p class="text-sm text-neutral-400 dark:text-neutral-500">{description}</p>
      </div>

      <!-- 统计 -->
      <div class="flex justify-center gap-6 mb-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-green-500" id="done-count">0</div>
          <div class="text-xs text-neutral-400">已完成</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-pink-400" id="todo-count">0</div>
          <div class="text-xs text-neutral-400">待实现</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-neutral-300 dark:text-neutral-600" id="total-count">0</div>
          <div class="text-xs text-neutral-400">总计</div>
        </div>
      </div>

      <!-- 进度条 -->
      <div class="w-full max-w-md mx-auto mb-8">
        <div class="h-2 bg-neutral-100 dark:bg-neutral-800 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-pink-400 to-pink-500 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="text-center text-xs text-neutral-400 mt-1" id="progress-text">0%</div>
      </div>

      <!-- 待实现 -->
      <div class="mb-8">
        <h2 class="text-lg font-bold text-neutral-700 dark:text-neutral-200 mb-3 flex items-center gap-2">
          <span class="text-xl">⏳</span> 待实现
        </h2>
        <div id="todo-list" class="space-y-2">
          <!-- JS 渲染 -->
        </div>
      </div>

      <!-- 已完成 -->
      <div>
        <h2 class="text-lg font-bold text-neutral-700 dark:text-neutral-200 mb-3 flex items-center gap-2">
          <span class="text-xl">✅</span> 已完成
        </h2>
        <div id="done-list" class="space-y-2">
          <!-- JS 渲染 -->
        </div>
        <div id="empty-done" class="text-center py-8 text-neutral-300 dark:text-neutral-600 text-sm hidden">
          还没有完成的心愿，一起加油吧 💪
        </div>
      </div>

      <!-- 添加心愿 -->
      <div class="mt-8 pt-6 border-t border-neutral-100 dark:border-neutral-800">
        <div class="flex gap-2 max-w-md mx-auto">
          <input
            type="text"
            id="new-wish-input"
            placeholder="添加新的心愿..."
            class="flex-1 px-4 py-2.5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-transparent text-neutral-800 dark:text-neutral-100 placeholder-neutral-300 dark:placeholder-neutral-600 focus:border-pink-300 focus:ring-1 focus:ring-pink-300 outline-none transition-all text-sm"
          />
          <button
            id="add-wish-btn"
            class="px-4 py-2.5 rounded-xl bg-pink-400 hover:bg-pink-500 text-white font-medium text-sm transition-colors active:scale-95"
          >
            添加
          </button>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<script is:inline>
(function() {
  var WISH_KEY = 'couple-wishlist-v1';

  var defaultWishes = [
    { id: 1, text: "一起看海", emoji: "🌊", completed: true },
    { id: 2, text: "一起逛夜市", emoji: "🏮", completed: true },
    { id: 3, text: "一起拍大头贴", emoji: "📸", completed: false },
    { id: 4, text: "一起看日出", emoji: "🌅", completed: false },
    { id: 5, text: "一起坐摩天轮", emoji: "🎡", completed: false },
    { id: 6, text: "一起做手工蛋糕", emoji: "🎂", completed: false },
    { id: 7, text: "一起露营看星星", emoji: "⛺", completed: false },
    { id: 8, text: "一起旅行一次", emoji: "✈️", completed: false },
    { id: 9, text: "一起养一只猫", emoji: "🐱", completed: false },
    { id: 10, text: "一起写一封信给未来的我们", emoji: "💌", completed: false },
  ];

  var emojis = ["🌟", "💫", "✨", "🎉", "💪", "🌈", "🎵", "🍰", "🏖️", "🎪", "🎭", "🎨", "🏠", "🦋", "🍀"];

  function loadWishes() {
    try {
      var data = localStorage.getItem(WISH_KEY);
      if (data) return JSON.parse(data);
    } catch(e) {}
    return defaultWishes;
  }

  function saveWishes(wishes) {
    try { localStorage.setItem(WISH_KEY, JSON.stringify(wishes)); } catch(e) {}
  }

  var wishes = loadWishes();

  function getNextId() {
    var max = 0;
    wishes.forEach(function(w) { if (w.id > max) max = w.id; });
    return max + 1;
  }

  function render() {
    var todoList = document.getElementById('todo-list');
    var doneList = document.getElementById('done-list');
    var emptyDone = document.getElementById('empty-done');
    if (!todoList || !doneList) return;

    var todoWishes = wishes.filter(function(w) { return !w.completed; });
    var doneWishes = wishes.filter(function(w) { return w.completed; });

    todoList.innerHTML = todoWishes.map(function(w) {
      return '<div class="wish-item flex items-center gap-3 p-3 rounded-xl bg-white/50 dark:bg-neutral-800/40 border border-pink-50 dark:border-pink-900/20 hover:border-pink-200 dark:hover:border-pink-800/40 transition-all group">' +
        '<button data-toggle="' + w.id + '" class="wish-check w-6 h-6 rounded-full border-2 border-pink-300 dark:border-pink-700 flex items-center justify-center text-xs text-transparent group-hover:border-pink-400 transition-all hover:scale-110">' +
          '<span class="group-hover:text-pink-400">✓</span>' +
        '</button>' +
        '<span class="text-lg">' + w.emoji + '</span>' +
        '<span class="flex-1 text-sm text-neutral-700 dark:text-neutral-200">' + w.text + '</span>' +
        '<button data-delete="' + w.id + '" class="text-xs text-neutral-300 dark:text-neutral-600 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100">✕</button>' +
      '</div>';
    }).join('');

    doneList.innerHTML = doneWishes.map(function(w) {
      return '<div class="wish-item flex items-center gap-3 p-3 rounded-xl bg-green-50/50 dark:bg-green-900/10 border border-green-100 dark:border-green-900/20 group">' +
        '<button data-toggle="' + w.id + '" class="wish-check w-6 h-6 rounded-full bg-green-400 flex items-center justify-center text-xs text-white">' +
          '✓' +
        '</button>' +
        '<span class="text-lg">' + w.emoji + '</span>' +
        '<span class="flex-1 text-sm text-neutral-400 dark:text-neutral-500 line-through">' + w.text + '</span>' +
        '<button data-delete="' + w.id + '" class="text-xs text-neutral-300 dark:text-neutral-600 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100">✕</button>' +
      '</div>';
    }).join('');

    if (emptyDone) {
      emptyDone.classList.toggle('hidden', doneWishes.length > 0);
    }

    // 更新统计
    var doneCountEl = document.getElementById('done-count');
    var todoCountEl = document.getElementById('todo-count');
    var totalCountEl = document.getElementById('total-count');
    var progressBar = document.getElementById('progress-bar');
    var progressText = document.getElementById('progress-text');

    if (doneCountEl) doneCountEl.textContent = doneWishes.length;
    if (todoCountEl) todoCountEl.textContent = todoWishes.length;
    if (totalCountEl) totalCountEl.textContent = wishes.length;

    var pct = wishes.length > 0 ? Math.round((doneWishes.length / wishes.length) * 100) : 0;
    if (progressBar) progressBar.style.width = pct + '%';
    if (progressText) progressText.textContent = pct + '%';
  }

  // 事件委托
  document.addEventListener('click', function(e) {
    var target = e.target;
    if (!target || !target.closest) return;

    // 切换完成状态
    var toggleBtn = target.closest('[data-toggle]');
    if (toggleBtn) {
      var id = parseInt(toggleBtn.getAttribute('data-toggle'));
      wishes = wishes.map(function(w) {
        if (w.id === id) {
          return { id: w.id, text: w.text, emoji: w.emoji, completed: !w.completed };
        }
        return w;
      });
      saveWishes(wishes);
      render();
      return;
    }

    // 删除
    var deleteBtn = target.closest('[data-delete]');
    if (deleteBtn) {
      var delId = parseInt(deleteBtn.getAttribute('data-delete'));
      wishes = wishes.filter(function(w) { return w.id !== delId; });
      saveWishes(wishes);
      render();
      return;
    }

    // 添加新心愿
    if (target.id === 'add-wish-btn' || target.closest('#add-wish-btn')) {
      addWish();
    }
  });

  // 回车添加
  var input = document.getElementById('new-wish-input');
  if (input) {
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') addWish();
    });
  }

  function addWish() {
    var inputEl = document.getElementById('new-wish-input');
    if (!inputEl) return;
    var text = inputEl.value.trim();
    if (!text) return;

    var emoji = emojis[Math.floor(Math.random() * emojis.length)];
    wishes.push({
      id: getNextId(),
      text: text,
      emoji: emoji,
      completed: false
    });
    saveWishes(wishes);
    inputEl.value = '';
    render();
  }

  render();
})();
</script>
