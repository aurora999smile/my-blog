---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { siteConfig } from "@/config";
import PostPage from "@/components/layout/PostPage.astro";

// 获取全部文章（不分分类）
const allPosts = await getSortedPosts();
const pageSize = siteConfig.pagination.postsPerPage;
// 显示全部文章（不分页，或取前 50 篇）
const displayPosts = allPosts.slice(0, 50);

// 创建一个兼容 PostPage 的 page 对象
const mockPage = {
  data: displayPosts,
  total: allPosts.length,
  size: pageSize,
  currentPage: 1,
  lastPage: 1,
  url: { current: "/categories/" },
};
---

<MainGridLayout title={i18n(I18nKey.categories)}>
    <!-- 页面标题 -->
    <div class="card-base px-8 py-6 mb-4">
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.categories)}
        </div>
        <p class="text-30 text-sm">
            全部文章 · {allPosts.length} {i18n(I18nKey.postsCount)}
        </p>
    </div>

    <!-- 全部文章列表（直接渲染，无分类筛选） -->
    <PostPage page={mockPage} />
</MainGridLayout>
