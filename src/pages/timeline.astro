---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "时光轴 & 心愿单";
const description = "我们的故事，我们的心愿";

// === 时间轴数据 ===
const milestones = [
  {
    date: "2024-07-14",
    title: "在一起啦 💕",
    desc: "从这一天开始，我们的故事正式启程。",
    icon: "💑",
    side: "left",
  },
  {
    date: "2024-09-15",
    title: "第一次见面 🌹",
    desc: "终于从线上走到线下，见到真实的彼此。",
    icon: "🌹",
    side: "right",
  },
  // 在下方继续添加新的里程碑...
];

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
  const weekday = weekdays[d.getDay()];
  return { full: `${year}.${month}.${day}`, weekday: `星期${weekday}` };
}

const sorted = milestones.sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
);
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-8 relative w-full">

      <!-- ========== 上半部分：时光轴 ========== -->
      <div class="text-center mb-6">
        <div class="text-2xl mb-1">⏳</div>
        <h1 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100 mb-1">时光轴</h1>
        <p class="text-sm text-neutral-400 dark:text-neutral-500">每一个重要的瞬间</p>
      </div>

      <div class="timeline-container relative mb-10">
        <div class="timeline-line absolute left-1/2 -translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-pink-300 via-pink-400 to-pink-300 dark:from-pink-700 dark:via-pink-600 dark:to-pink-700"></div>

        {sorted.map((item) => {
          const { full, weekday } = formatDate(item.date);
          const isLeft = item.side === "left";
          return (
            <div class={`timeline-item relative flex items-center mb-8 ${isLeft ? "flex-row" : "flex-row-reverse"}`}>
              <div class={`w-[calc(50%-1.5rem)] ${isLeft ? "pr-4 text-right" : "pl-4 text-left"}`}>
                <div class="timeline-card inline-block p-4 rounded-xl bg-white/60 dark:bg-neutral-800/60 border border-pink-100 dark:border-pink-900/30 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 max-w-full text-left">
                  <div class="text-xs text-pink-400 dark:text-pink-500 font-medium mb-1">{full} {weekday}</div>
                  <div class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</div>
                  <div class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</div>
                </div>
              </div>
              <div class="timeline-dot absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-pink-100 dark:bg-pink-900/40 border-2 border-pink-300 dark:border-pink-700 flex items-center justify-center text-sm z-10 shadow-sm">{item.icon}</div>
              <div class="w-[calc(50%-1.5rem)]"></div>
            </div>
          );
        })}

        <div class="relative flex items-center justify-center py-4">
          <div class="timeline-dot absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-pink-50 dark:bg-pink-900/20 border-2 border-dashed border-pink-300 dark:border-pink-700 flex items-center justify-center text-sm z-10">✨</div>
        </div>
      </div>

      <!-- ========== 分隔线 ========== -->
      <div class="border-t border-pink-100 dark:border-pink-900/30 my-8"></div>

      <!-- ========== 下半部分：心愿清单 ========== -->
      <div class="text-center mb-6">
        <div class="text-2xl mb-1">Bucket List</div>
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100 mb-1">心愿清单</h2>
        <p class="text-sm text-neutral-400 dark:text-neutral-500">一起想做的事，一起走过的路</p>
      </div>

      <!-- 统计 -->
      <div class="flex justify-center gap-6 mb-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-green-500" id="done-count">0</div>
          <div class="text-xs text-neutral-400">已完成</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-pink-400" id="todo-count">0</div>
          <div class="text-xs text-neutral-400">待实现</div>
        </div>
      </div>

      <!-- 进度条 -->
      <div class="w-full max-w-md mx-auto mb-8">
        <div class="h-2 bg-neutral-100 dark:bg-neutral-800 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-pink-400 to-pink-500 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="text-center text-xs text-neutral-400 mt-1" id="progress-text">0%</div>
      </div>

      <!-- 待实现 -->
      <div class="mb-8">
        <h3 class="text-lg font-bold text-neutral-700 dark:text-neutral-200 mb-3 flex items-center gap-2">
          <span class="text-xl">⏳</span> 待实现
        </h3>
        <div id="todo-list" class="space-y-2"></div>
      </div>

      <!-- 已完成 -->
      <div>
        <h3 class="text-lg font-bold text-neutral-700 dark:text-neutral-200 mb-3 flex items-center gap-2">
          <span class="text-xl">✅</span> 已完成
        </h3>
        <div id="done-list" class="space-y-2"></div>
        <div id="empty-done" class="text-center py-8 text-neutral-300 dark:text-neutral-600 text-sm hidden">
          还没有完成的心愿，一起加油吧 💪
        </div>
      </div>

      <!-- 添加心愿 -->
      <div class="mt-8 pt-6 border-t border-neutral-100 dark:border-neutral-800">
        <div class="flex gap-2 max-w-md mx-auto">
          <input type="text" id="new-wish-input" placeholder="添加新的心愿..."
            class="flex-1 px-4 py-2.5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-transparent text-neutral-800 dark:text-neutral-100 placeholder-neutral-300 dark:placeholder-neutral-600 focus:border-pink-300 focus:ring-1 focus:ring-pink-300 outline-none transition-all text-sm" />
          <button id="add-wish-btn"
            class="px-4 py-2.5 rounded-xl bg-pink-400 hover:bg-pink-500 text-white font-medium text-sm transition-colors active:scale-95">
            添加
          </button>
        </div>
      </div>

    </div>
  </div>
</MainGridLayout>

<style>
  @media (max-width: 768px) {
    .timeline-container .timeline-line { left: 1rem; }
    .timeline-item { flex-direction: row !important; }
    .timeline-item > div:first-child { width: calc(100% - 3rem) !important; padding-left: 0.75rem !important; padding-right: 0 !important; text-align: left !important; }
    .timeline-item > div:last-child { display: none !important; }
    .timeline-dot { left: 1rem !important; }
  }
</style>

<script is:inline>
(function() {
  var WISH_KEY = 'couple-wishlist-v1';
  var defaultWishes = [
    { id: 1, text: "一起看海", emoji: "🌊", completed: true },
    { id: 2, text: "一起逛夜市", emoji: "🏮", completed: true },
    { id: 3, text: "一起拍大头贴", emoji: "📸", completed: false },
    { id: 4, text: "一起看日出", emoji: "🌅", completed: false },
    { id: 5, text: "一起坐摩天轮", emoji: "🎡", completed: false },
    { id: 6, text: "一起做手工蛋糕", emoji: "🎂", completed: false },
    { id: 7, text: "一起露营看星星", emoji: "⛺", completed: false },
    { id: 8, text: "一起旅行一次", emoji: "✈️", completed: false },
    { id: 9, text: "一起养一只猫", emoji: "🐱", completed: false },
    { id: 10, text: "一起写一封信给未来的我们", emoji: "💌", completed: false },
  ];
  var emojis = ["🌟","💫","✨","🎉","💪","🌈","🎵","🍰","🏖️","🎪","🎭","🎨","🏠","🦋","🍀"];

  function loadWishes() {
    try { var d = localStorage.getItem(WISH_KEY); if (d) return JSON.parse(d); } catch(e) {}
    return defaultWishes;
  }
  function saveWishes(w) { try { localStorage.setItem(WISH_KEY, JSON.stringify(w)); } catch(e) {} }
  var wishes = loadWishes();
  function getNextId() { var m = 0; wishes.forEach(function(w) { if (w.id > m) m = w.id; }); return m + 1; }

  function render() {
    var todoList = document.getElementById('todo-list');
    var doneList = document.getElementById('done-list');
    var emptyDone = document.getElementById('empty-done');
    if (!todoList || !doneList) return;
    var todoW = wishes.filter(function(w) { return !w.completed; });
    var doneW = wishes.filter(function(w) { return w.completed; });

    todoList.innerHTML = todoW.map(function(w) {
      return '<div class="wish-item flex items-center gap-3 p-3 rounded-xl bg-white/50 dark:bg-neutral-800/40 border border-pink-50 dark:border-pink-900/20 hover:border-pink-200 dark:hover:border-pink-800/40 transition-all group">' +
        '<button data-toggle="' + w.id + '" class="wish-check w-6 h-6 rounded-full border-2 border-pink-300 dark:border-pink-700 flex items-center justify-center text-xs text-transparent group-hover:border-pink-400 transition-all hover:scale-110"><span class="group-hover:text-pink-400">✓</span></button>' +
        '<span class="text-lg">' + w.emoji + '</span>' +
        '<span class="flex-1 text-sm text-neutral-700 dark:text-neutral-200">' + w.text + '</span>' +
        '<button data-delete="' + w.id + '" class="text-xs text-neutral-300 dark:text-neutral-600 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100">✕</button>' +
      '</div>';
    }).join('');

    doneList.innerHTML = doneW.map(function(w) {
      return '<div class="wish-item flex items-center gap-3 p-3 rounded-xl bg-green-50/50 dark:bg-green-900/10 border border-green-100 dark:border-green-900/20 group">' +
        '<button data-toggle="' + w.id + '" class="wish-check w-6 h-6 rounded-full bg-green-400 flex items-center justify-center text-xs text-white">✓</button>' +
        '<span class="text-lg">' + w.emoji + '</span>' +
        '<span class="flex-1 text-sm text-neutral-400 dark:text-neutral-500 line-through">' + w.text + '</span>' +
        '<button data-delete="' + w.id + '" class="text-xs text-neutral-300 dark:text-neutral-600 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100">✕</button>' +
      '</div>';
    }).join('');

    if (emptyDone) emptyDone.classList.toggle('hidden', doneW.length > 0);
    var dc = document.getElementById('done-count');
    var tc = document.getElementById('todo-count');
    var pb = document.getElementById('progress-bar');
    var pt = document.getElementById('progress-text');
    if (dc) dc.textContent = doneW.length;
    if (tc) tc.textContent = todoW.length;
    var pct = wishes.length > 0 ? Math.round((doneW.length / wishes.length) * 100) : 0;
    if (pb) pb.style.width = pct + '%';
    if (pt) pt.textContent = pct + '%';
  }

  document.addEventListener('click', function(e) {
    var t = e.target;
    if (!t || !t.closest) return;
    var tb = t.closest('[data-toggle]');
    if (tb) {
      var id = parseInt(tb.getAttribute('data-toggle'));
      wishes = wishes.map(function(w) { return w.id === id ? { id: w.id, text: w.text, emoji: w.emoji, completed: !w.completed } : w; });
      saveWishes(wishes); render(); return;
    }
    var db = t.closest('[data-delete]');
    if (db) {
      var did = parseInt(db.getAttribute('data-delete'));
      wishes = wishes.filter(function(w) { return w.id !== did; });
      saveWishes(wishes); render(); return;
    }
    if (t.id === 'add-wish-btn' || t.closest('#add-wish-btn')) addWish();
  });

  var inp = document.getElementById('new-wish-input');
  if (inp) inp.addEventListener('keydown', function(e) { if (e.key === 'Enter') addWish(); });

  function addWish() {
    var el = document.getElementById('new-wish-input');
    if (!el) return;
    var text = el.value.trim();
    if (!text) return;
    wishes.push({ id: getNextId(), text: text, emoji: emojis[Math.floor(Math.random() * emojis.length)], completed: false });
    saveWishes(wishes); el.value = ''; render();
  }
  render();
})();
</script>
