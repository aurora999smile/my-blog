---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "我们的故事";
const description = "用时间线记录每一个重要的瞬间";

// 时间轴数据 — 在这里添加新的里程碑
// 格式: { date: "YYYY-MM-DD", title: "标题", desc: "描述", icon: "emoji", side: "left"|"right" }
const milestones = [
  {
    date: "2024-07-14",
    title: "在一起啦 💕",
    desc: "从这一天开始，我们的故事正式启程。",
    icon: "💑",
    side: "left",
  },
  {
    date: "2024-09-15",
    title: "第一次见面 🌹",
    desc: "终于从线上走到线下，见到真实的彼此。",
    icon: "🌹",
    side: "right",
  },
  // 在下方继续添加新的里程碑...
  // {
  //   date: "2024-12-25",
  //   title: "第一个圣诞节 🎄",
  //   desc: "一起度过的第一个节日。",
  //   icon: "🎄",
  //   side: "left",
  // },
];

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
  const weekday = weekdays[d.getDay()];
  return { full: `${year}.${month}.${day}`, weekday: `星期${weekday}` };
}

// 按日期排序
const sorted = milestones.sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
);
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-8 relative w-full">
      <!-- 页面标题 -->
      <div class="text-center mb-8">
        <div class="text-3xl mb-2">📖</div>
        <h1 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100 mb-1">
          {title}
        </h1>
        <p class="text-sm text-neutral-400 dark:text-neutral-500">{description}</p>
      </div>

      <!-- 时间轴 -->
      <div class="timeline-container relative">
        <!-- 中轴线 -->
        <div class="timeline-line absolute left-1/2 -translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-pink-300 via-pink-400 to-pink-300 dark:from-pink-700 dark:via-pink-600 dark:to-pink-700"></div>

        {sorted.map((item) => {
          const { full, weekday } = formatDate(item.date);
          const isLeft = item.side === "left";
          return (
            <div class={`timeline-item relative flex items-center mb-8 ${isLeft ? "flex-row" : "flex-row-reverse"}`}>
              {/* 内容卡片 */}
              <div class={`w-[calc(50%-1.5rem)] ${isLeft ? "pr-4 text-right" : "pl-4 text-left"}`}>
                <div class="timeline-card inline-block p-4 rounded-xl bg-white/60 dark:bg-neutral-800/60 border border-pink-100 dark:border-pink-900/30 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 max-w-full text-left">
                  <div class="text-xs text-pink-400 dark:text-pink-500 font-medium mb-1">
                    {full} {weekday}
                  </div>
                  <div class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-1">
                    {item.title}
                  </div>
                  <div class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                    {item.desc}
                  </div>
                </div>
              </div>

              {/* 中心圆点 */}
              <div class="timeline-dot absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-pink-100 dark:bg-pink-900/40 border-2 border-pink-300 dark:border-pink-700 flex items-center justify-center text-sm z-10 shadow-sm">
                {item.icon}
              </div>

              {/* 另一侧留白 */}
              <div class="w-[calc(50%-1.5rem)]"></div>
            </div>
          );
        })}

        {/* 未完待续 */}
        <div class="relative flex items-center justify-center py-4">
          <div class="timeline-dot absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-pink-50 dark:bg-pink-900/20 border-2 border-dashed border-pink-300 dark:border-pink-700 flex items-center justify-center text-sm z-10">
            ✨
          </div>
        </div>
      </div>

      {/* 添加提示 */}
      <div class="text-center mt-6 text-sm text-neutral-300 dark:text-neutral-600">
        更多故事正在书写中...
      </div>
    </div>
  </div>
</MainGridLayout>

<style>
  /* 移动端：改为单列布局 */
  @media (max-width: 768px) {
    .timeline-container .timeline-line {
      left: 1rem;
    }
    .timeline-item {
      flex-direction: row !important;
    }
    .timeline-item > div:first-child {
      width: calc(100% - 3rem) !important;
      padding-left: 0.75rem !important;
      padding-right: 0 !important;
      text-align: left !important;
    }
    .timeline-item > div:last-child {
      display: none !important;
    }
    .timeline-dot {
      left: 1rem !important;
    }
  }
</style>
